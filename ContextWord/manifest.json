{
  "manifest_version": 3,
  "name": "Context Word",
  "version": "2.0",
  "description": "Explain highlighted words using their surrounding context.",
  "permissions": [],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}